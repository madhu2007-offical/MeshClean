## 🤖 Building Your Own Agent

```python
from pipeline_debug_env import make_env

class MyAgent:
    def __init__(self, task_id):
        self.env = make_env(task_id)
    
    def run(self):
        obs = self.env.reset()
        total_reward = 0.0
        
        # Step 1: Start by understanding the error
        print(f"Error: {obs.error_log}")
        
        # Step 2: Explore the pipeline
        for node in obs.parents:
            result = self.env.step({
                "action_type": "inspect_node",
                "node": node
            })
            total_reward += result.reward
        
        # Step 3: Make prediction
        result = self.env.step({
            "action_type": "submit_root_cause",
            "node": "data_source"
        })
        total_reward += result.reward
        
        return {
            "total_reward": total_reward,
            "steps": self.env.state.step_count,
            "result": result.info
        }

# Run it
agent = MyAgent("task_1")
summary = agent.run()
print(f"Total reward: {summary['total_reward']}")
```

